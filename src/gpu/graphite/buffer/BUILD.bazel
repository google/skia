load("//bazel:skia_rules.bzl", "skia_filegroup", "split_srcs_and_hdrs")

package(
    default_applicable_licenses = ["//:license"],
)

licenses(["notice"])

CORE_FILES = [
    "Buffer.cpp",
    "Buffer.h",
    "BufferManager.cpp",
    "BufferManager.h",
    "ClientMappedBufferManager.cpp",
    "ClientMappedBufferManager.h",
    "UploadBufferManager.cpp",
    "UploadBufferManager.h",
]

split_srcs_and_hdrs(
    name = "core",
    files = CORE_FILES,
)

skia_filegroup(
    name = "buffer_hdrs",
    srcs = [":core_hdrs"],
    visibility = ["//src/gpu/graphite:__pkg__"],
)

skia_filegroup(
    name = "buffer_srcs",
    srcs = [":core_srcs"],
    visibility = ["//src/gpu/graphite:__pkg__"],
)
