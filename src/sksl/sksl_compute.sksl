// defines built-in interfaces supported by SkSL compute shaders

layout(builtin=24) in uint3 sk_NumWorkgroups;
layout(builtin=26) in uint3 sk_WorkgroupID;
layout(builtin=27) in uint3 sk_LocalInvocationID;
layout(builtin=28) in uint3 sk_GlobalInvocationID;
layout(builtin=29) in uint sk_LocalInvocationIndex;

// Subgroup builtins. Using these requires ShaderCaps::fSubgroupSupport. Don't assume
// sk_SubgroupID * sk_SubgroupSize + sk_SubgroupInvocationID == sk_LocalInvocationIndex; the
// layout of subgroups within a workgroup is implementation-defined and the last subgroup may be
// partially filled.
layout(builtin=36) in uint sk_SubgroupSize;
layout(builtin=40) in uint sk_SubgroupID;
layout(builtin=41) in uint sk_SubgroupInvocationID;

struct IndirectDispatchArgs {
    int x, y, z;
};

void textureWrite($writableTexture2D t, uint2 pos, half4 color);

$pure uint textureWidth($genTexture2D t);
$pure uint textureHeight($genTexture2D t);

// Control-barrier with memory-ordering constraints applied to
// workgroup shared memory only.
void workgroupBarrier();

// Control-barrier with memory-ordering constraints applied to
// uniform and storage-buffer memory.
void storageBarrier();

$pure $genType  workgroupUniformLoad($genType  x);
$pure $genHType workgroupUniformLoad($genHType x);
$pure $genIType workgroupUniformLoad($genIType x);
$pure $genUType workgroupUniformLoad($genUType x);
$pure $genBType workgroupUniformLoad($genBType x);
$pure $mat      workgroupUniformLoad($mat      x);
$pure $hmat     workgroupUniformLoad($hmat     x);

// Subgroup operations. Using these requires ShaderCaps::fSubgroupSupport. They operate on the
// active invocations of the calling subgroup. Unless ShaderCaps::fSubgroupMaximalReconvergence is
// set, calling these in non-uniform control flow is rejected in WGSL and has implementation-defined
// active invocations on other backends.
$pure bool  subgroupAll(bool value);
$pure bool  subgroupAny(bool value);
// Bit N of the result is set when `value` is true in the active invocation whose
// sk_SubgroupInvocationID is N.
$pure uint4 subgroupBallot(bool value);

// `id` must be a constant expression less than 128 (the largest subgroup size WGSL allows).
// SPIR-V before 1.5, GLSL and WGSL all require a constant id.
$pure $genType  subgroupBroadcast($genType  value, uint id);
$pure $genHType subgroupBroadcast($genHType value, uint id);
$pure $genIType subgroupBroadcast($genIType value, uint id);
$pure $genUType subgroupBroadcast($genUType value, uint id);

// Returns `value` from the active invocation with the lowest sk_SubgroupInvocationID.
$pure $genType  subgroupBroadcastFirst($genType  value);
$pure $genHType subgroupBroadcastFirst($genHType value);
$pure $genIType subgroupBroadcastFirst($genIType value);
$pure $genUType subgroupBroadcastFirst($genUType value);

