[
  {
    "cmd": [
      "luci-auth",
      "token",
      "-scopes",
      "https://www.googleapis.com/auth/devstorage.read_write",
      "-lifetime",
      "3m"
    ],
    "infra_step": true,
    "name": "get access token for default account"
  },
  {
    "cmd": [
      "gcloud",
      "storage",
      "cp",
      "-Z",
      "/foo/file",
      "gs://bar-bucket/file"
    ],
    "env": {
      "CLOUDSDK_AUTH_ACCESS_TOKEN": "extra.secret.token.should.not.be.logged"
    },
    "name": "upload test file",
    "~followup_annotations": [
      "@@@STEP_FAILURE@@@"
    ]
  },
  {
    "cmd": [
      "luci-auth",
      "token",
      "-scopes",
      "https://www.googleapis.com/auth/devstorage.read_write",
      "-lifetime",
      "3m"
    ],
    "infra_step": true,
    "name": "get access token for default account (2)"
  },
  {
    "cmd": [
      "gcloud",
      "storage",
      "cp",
      "-Z",
      "/foo/file",
      "gs://bar-bucket/file"
    ],
    "env": {
      "CLOUDSDK_AUTH_ACCESS_TOKEN": "extra.secret.token.should.not.be.logged"
    },
    "name": "upload test file (attempt 2)"
  },
  {
    "name": "$result"
  }
]