[
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "glob",
      "[START_DIR]/test",
      "*.png"
    ],
    "infra_step": true,
    "name": "find .png images",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@glob@[START_DIR]/test/someimage.png@@@",
      "@@@STEP_LOG_END@glob@@@"
    ]
  },
  {
    "cmd": [
      "luci-auth",
      "token",
      "-scopes",
      "https://www.googleapis.com/auth/devstorage.read_write",
      "-lifetime",
      "3m"
    ],
    "infra_step": true,
    "name": "get access token for default account"
  },
  {
    "cmd": [
      "gcloud",
      "storage",
      "cp",
      "[START_DIR]/test/*.png",
      "gs://skia-infra-gm-alt/dm-images-v1"
    ],
    "env": {
      "CLOUDSDK_AUTH_ACCESS_TOKEN": "extra.secret.token.should.not.be.logged"
    },
    "name": "upload .png images"
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "glob",
      "[START_DIR]/test",
      "*.pdf"
    ],
    "infra_step": true,
    "name": "find .pdf images",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@glob@[START_DIR]/test/someimage.png@@@",
      "@@@STEP_LOG_END@glob@@@"
    ]
  },
  {
    "cmd": [
      "luci-auth",
      "token",
      "-scopes",
      "https://www.googleapis.com/auth/devstorage.read_write",
      "-lifetime",
      "3m"
    ],
    "infra_step": true,
    "name": "get access token for default account (2)"
  },
  {
    "cmd": [
      "gcloud",
      "storage",
      "cp",
      "-Z",
      "[START_DIR]/test/dm.json",
      "gs://skia-infra-gm-alt/dm-json-v1/2012/05/14/12/abc123/Upload-Test-Debian10-Clang-GCE-CPU-AVX2-x86_64-Debug-All/1337000001/dm.json"
    ],
    "env": {
      "CLOUDSDK_AUTH_ACCESS_TOKEN": "extra.secret.token.should.not.be.logged"
    },
    "name": "upload dm.json"
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "listdir",
      "[START_DIR]/test"
    ],
    "infra_step": true,
    "name": "check for optional verbose.log file",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@listdir@[START_DIR]/test/dm.json@@@",
      "@@@STEP_LOG_LINE@listdir@[START_DIR]/test/verbose.log@@@",
      "@@@STEP_LOG_END@listdir@@@"
    ]
  },
  {
    "cmd": [
      "luci-auth",
      "token",
      "-scopes",
      "https://www.googleapis.com/auth/devstorage.read_write",
      "-lifetime",
      "3m"
    ],
    "infra_step": true,
    "name": "get access token for default account (3)"
  },
  {
    "cmd": [
      "gcloud",
      "storage",
      "cp",
      "-Z",
      "[START_DIR]/test/verbose.log",
      "gs://skia-infra-gm-alt/dm-json-v1/2012/05/14/12/abc123/Upload-Test-Debian10-Clang-GCE-CPU-AVX2-x86_64-Debug-All/1337000001/verbose.log"
    ],
    "env": {
      "CLOUDSDK_AUTH_ACCESS_TOKEN": "extra.secret.token.should.not.be.logged"
    },
    "name": "upload verbose.log"
  },
  {
    "name": "$result"
  }
]