layout(local_size_x = 64) in;

layout(metal, binding = 0) buffer outputs {
    uint outputBuffer[];
};

void main() {
    uint x = sk_GlobalInvocationID.x;
    outputBuffer[x] = subgroupAdd(x) + subgroupMin(x) + subgroupMax(x) +
                      subgroupInclusiveAdd(x) + subgroupExclusiveAdd(x);
}
